# =====================================================================
# EUIPD 研发过程管理系统 部署参数模板
#
# 用法：cp .env.example .env，按注释填写后执行 ./euipd.sh init。
#   - 标“必填”的项须由部署者填写；
#   - 标“自动生成”的项留空时，由 ./euipd.sh init 生成随机值并写回 .env；
#   - 可选外部集成不使用时保持为空，相关功能不可用。
# .env 含口令与密钥，权限应为 600，不得提交到版本库或外发。
# 本文件列出了部署所需的全部账号、口令与密钥，代码与配置中没有其他内置账号。
# =====================================================================

# ---------- 访问地址（必填） ----------
# 服务器地址：浏览器访问用的 IP 或域名，不能填 127.0.0.1 或 localhost
SERVER_HOST=
# 对外 HTTP 端口；80 被占用时可改为 8080 等
HTTP_PORT=80
# 浏览器访问系统的完整地址（可选）。经外部 HTTPS 反向代理或域名访问时填写，例如 https://euipd.example.com；
# 留空时按 http://SERVER_HOST:HTTP_PORT 拼出
PUBLIC_URL=

# ---------- 平台超级管理员（必填，只在首次初始化数据库时写入） ----------
# 系统唯一的内置管理账号。登录手机号：11 位数字
SUPER_ADMIN_PHONE=
# 显示姓名：不超过 20 个字符，不得含引号、反斜杠、反引号和 $
SUPER_ADMIN_NAME=平台管理员
# 初始口令：8 至 32 位并同时含字母与数字，不得含引号、反斜杠、反引号和 $。
# 数据库建成后修改本项不起作用；首次登录确认无误后在系统内修改口令，并清空本项
SUPER_ADMIN_PASSWORD=

# ---------- 成员初始口令（必填） ----------
# 新建成员与重置口令后的初始口令：8 至 32 位并同时含字母与数字；以此口令登录的成员须先设置新口令
EUIPD_INITIAL_PASSWORD=

# ---------- 基础组件账号与口令（自动生成） ----------
# MySQL root 口令；应用使用专用账号 euipd，其口令为 EUIPD_DB_PASSWORD
MYSQL_ROOT_PASSWORD=
EUIPD_DB_PASSWORD=
# Redis 访问口令
EUIPD_REDIS_PASSWORD=
# MinIO 管理员账号与口令（留空时账号取 euipd-admin）
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# 应用访问对象存储使用的专用账号与密钥（留空时账号取 euipd-app）
EUIPD_OSS_ACCESS_KEY_ID=
EUIPD_OSS_ACCESS_KEY_SECRET=

# ---------- 前端构建参数（自动生成） ----------
# 机构注册口令的加盐字符串，由 scripts/build-artifacts.sh 构建前端时读取；留空时自动生成。
# 该值编译进前端代码，只用于区分部署，不是密钥；系统投入使用后不得再修改
VUE_APP_PASSWORD_KEY=

# ---------- 可选外部集成（不使用时保持为空） ----------
# 阿里云短信：AccessKey、签名与模板编号；为空时短信验证码、短信找回口令与短信通知不可用
EUIPD_CUSTOMER_ACCESS_KEY_ID=
EUIPD_CUSTOMER_ACCESS_KEY_SECRET=
EUIPD_SMS_SIGNATURE=
EUIPD_SMS_VERIFICATION_TEMPLATE=
EUIPD_SMS_NOTIFY_TEMPLATE=
# 新机构注册时通知平台管理员复核、复核通过时通知注册人的短信模板
EUIPD_SMS_REGISTER_RECHECK_TEMPLATE=
EUIPD_SMS_REGISTER_PASS_TEMPLATE=

# 阿里云视频点播：登录页介绍视频播放与视频上传；为空时视频不可用
EUIPD_VOD_ACCESS_KEY_ID=
EUIPD_VOD_ACCESS_KEY_SECRET=
# 视频上传参数：地域缺省 cn-shanghai
EUIPD_VOD_REGION_ID=
EUIPD_VOD_CATEGORY_ID=
EUIPD_VOD_WORKFLOW_ID=
EUIPD_VOD_STORAGE_LOCATION=

# 保利威直播：用户编号、应用标识与密钥；为空时跳过直播初始化
EUIPD_POLYV_USER_ID=
EUIPD_POLYV_APP_ID=
EUIPD_POLYV_APP_SECRET=

# GitLab 地址与访问令牌
EUIPD_GITLAB_URL=
EUIPD_GITLAB_TOKEN=

# FTP 服务器（ftp 服务使用）：地址缺省 127.0.0.1，端口缺省 21，工作目录缺省 /
EUIPD_FTP_HOST=
EUIPD_FTP_PORT=
EUIPD_FTP_USERNAME=
EUIPD_FTP_PASSWORD=
EUIPD_FTP_WORKING_DIRECTORY=

# 泛微 OA（ecology）：地址、应用标识、密钥、公钥与物料表单创建人的 OA 用户编号
EUIPD_OA_HOST=
EUIPD_OA_APPID=
EUIPD_OA_SECRET=
EUIPD_OA_SPK=
EUIPD_OA_MATERIAL_FORM_CREATER=
# 外部 SQL Server 物料库（与 OA 集成配套）
EUIPD_SQL_SERVER_URL=
EUIPD_SQL_SERVER_USER=
EUIPD_SQL_SERVER_PASSWORD=

# ---------- 运行参数 ----------
TZ=Asia/Shanghai
# 数据目录（MySQL、Redis、MinIO、日志）；建议放在容量充足的独立磁盘，可填绝对路径
DATA_DIR=./data
# 容器内部网络前缀（/24），与本单位网段冲突时修改，例如 172.31.5
DOCKER_SUBNET_PREFIX=172.30.0
# MinIO 管理控制台端口，只绑定本机回环地址
MINIO_CONSOLE_PORT=18101
# 启用 Collabora（正式文件生成 PDF、Word 导入与在线查看）时填 collabora；不需要时留空
COMPOSE_PROFILES=
# 经外部 HTTPS 反向代理访问（PUBLIC_URL 以 https:// 开头）且启用 Collabora 时改为 true
COLLABORA_SSL_TERMINATION=false
COMPOSE_PROJECT_NAME=euipd
# 备份保留份数
BACKUP_KEEP=14

# ---------- 镜像来源 ----------
# 缺省从 Docker Hub 拉取。服务器无法访问 Docker Hub 时，二选一：
#   1) 在 /etc/docker/daemon.json 配置 registry-mirrors（见部署说明书），本段保持不变；
#   2) 填写镜像加速地址的主机名，经 registry-mirrors 拉取失败的镜像由 init 改以带该前缀的名称拉取，再打回原名
REGISTRY_MIRROR=
MYSQL_IMAGE=mysql:8.0
REDIS_IMAGE=redis:7-alpine
NGINX_IMAGE=nginx:1.27-alpine
JAVA_IMAGE=eclipse-temurin:11-jre
# MinIO 官方镜像已停止公开发布，使用同一发行版的 Bitnami 存档镜像（含 mc 客户端）；无法拉取时见部署说明书 2.3 节离线导入
MINIO_IMAGE=bitnamilegacy/minio:2025.4.22
COLLABORA_BASE_IMAGE=collabora/code:24.04.13.2.1
# 应用镜像版本：缺省 current（最近一次 init 或 upgrade 构建）；每次构建同时保留 euipd/app:<系统版本> 标签，
# 回退时填已存在的版本号（docker images euipd/app 查看），再执行 ./euipd.sh up
EUIPD_VERSION=

# ---------- Java 内存 ----------
# 以下按 8GB 以上内存设定；内存较小时按部署说明书调低
JAVA_OPTS_GATEWAY=-Xms256m -Xmx512m
JAVA_OPTS_SYSTEM=-Xms256m -Xmx768m
JAVA_OPTS_CUSTOMER=-Xms512m -Xmx1536m
JAVA_OPTS_FILE2=-Xms256m -Xmx1024m
JAVA_OPTS_FTP=-Xms128m -Xmx384m
