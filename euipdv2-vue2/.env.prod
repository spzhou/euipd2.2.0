NODE_ENV=production

# 网关地址：浏览器访问后端的入口。经 nginx 同源反向代理时填 /api（转发规则见根目录 README.md 第五节）
VUE_APP_SERVER=/api

VUE_APP_VERSION=standard
VUE_APP_USERTYPE=manufacturer
# MinIO 公共资源前缀：经 nginx 同源访问时使用路径前缀
VUE_APP_OSS_DOC_BASE=/euipd-doc
VUE_APP_OSS_WEB_BASE=/euipd-web

# 机构注册口令的加盐字符串（必填）：每个部署自行生成随机值，例如 openssl rand -hex 16
# 该值会编译进前端代码，只用于区分部署，不能当作密钥；建议写在 .env.*.local 中
VUE_APP_PASSWORD_KEY=
