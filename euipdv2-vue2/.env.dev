NODE_ENV=development

VUE_APP_SERVER=http://127.0.0.1:18000
VUE_APP_VERSION=standard
VUE_APP_USERTYPE=manufacturer
# MinIO 公共资源前缀（path-style）
VUE_APP_OSS_DOC_BASE=http://127.0.0.1:18100/euipd-doc
VUE_APP_OSS_WEB_BASE=http://127.0.0.1:18100/euipd-web

# 机构注册口令的加盐字符串（必填）：每个部署自行生成随机值，例如 openssl rand -hex 16
# 该值会编译进前端代码，只用于区分部署，不能当作密钥；建议写在 .env.*.local 中
VUE_APP_PASSWORD_KEY=
