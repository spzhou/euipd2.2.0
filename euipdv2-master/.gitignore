# 构建产物
target/
build/
out/
bin/
*.class
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar
*.jar
# 随仓库提供的二进制：公共库 server、Maven Wrapper
!lib/repo/**/*.jar
!.mvn/wrapper/maven-wrapper.jar

# IDE
.idea/
*.iws
*.iml
*.ipr
.vscode/
.eclipse/
.project
.classpath
.settings/
.factorypath
.apt_generated
.springBeans
.sts4-cache

# 操作系统
.DS_Store
Thumbs.db
*.tmp
*.bak
*.swp

# 日志与运行时文件
logs/
*.log
hs_err_pid*
logging.file.path_IS_UNDEFINED/
log.path_IS_UNDEFINED/
pids
*.pid
__pycache__/

# 本机凭据与密钥（不得提交）
keys/
*.pem
.env
.env.local
.env.*.local
docker/.env.local
application-local.properties
application-local.yml
bootstrap-local.properties

# Collabora 字体由 docker/collabora/fetch-fonts.sh 下载
docker/collabora/fonts/*
!docker/collabora/fonts/.gitkeep
