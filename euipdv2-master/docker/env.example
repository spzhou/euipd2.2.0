# =====================================================================
# EUIPD 本地开发环境参数
#
# 用法：cp docker/env.example docker/.env.local，按注释填写后再启动；
#       或执行 bash scripts/generate-local-env.sh，自动生成随机口令与测试超级管理员账号。
#   - docker/start-env.sh 以 --env-file docker/.env.local 启动 MySQL、Redis、MinIO 等容器；
#   - docker/start-services.sh 启动微服务时自动加载本文件，替换配置中的 ${EUIPD_*} 占位符。
# docker/.env.local 已被 .gitignore 忽略，不得提交到版本库。
# 标“必填”的项不能留空；口令请自行设定，建议 12 位以上并含大小写字母与数字。
# 以 # 开头的“键=值”行为可选项，缺省值即所示值；需要修改时去掉 # 再填写。
# 本文件列出了系统用到的全部账号、口令与密钥，代码与配置中没有其他内置账号。
# =====================================================================

# ---------- 基础组件（Docker Compose 使用） ----------
# MySQL root 口令（必填）
MYSQL_ROOT_PASSWORD=
# Redis 访问口令（必填）
REDIS_PASSWORD=
# MinIO 管理员账号与口令（必填；口令至少 8 位）
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# RabbitMQ 管理账号（可选组件，代码目前未调用；必填以便容器启动）
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=

# ---------- 微服务（必填） ----------
# 数据库口令：开发环境以 root 连库时与 MYSQL_ROOT_PASSWORD 相同
EUIPD_DB_PASSWORD=
# Redis 口令：与 REDIS_PASSWORD 相同
EUIPD_REDIS_PASSWORD=
# 对象存储访问密钥：开发环境可直接使用 MINIO_ROOT_USER / MINIO_ROOT_PASSWORD
EUIPD_OSS_ACCESS_KEY_ID=
EUIPD_OSS_ACCESS_KEY_SECRET=
# 新建成员与重置口令后的初始口令：8 至 32 位并同时含字母与数字
EUIPD_INITIAL_PASSWORD=

# ---------- 微服务连接地址（可选） ----------
# 数据库连接与账号；生产环境建议为应用单独建账号
# EUIPD_DB_URL=jdbc:mysql://127.0.0.1:3306/mycourse_bk?useUnicode=true&serverTimezone=Asia/Shanghai&characterEncoding=utf8&autoReconnect=true&useSSL=false&allowMultiQueries=true&allowPublicKeyRetrieval=true
# EUIPD_DB_USERNAME=root
# EUIPD_REDIS_HOST=127.0.0.1
# EUIPD_REDIS_PORT=6379
# 对象存储地址
# EUIPD_OSS_ENDPOINT=http://127.0.0.1:18100
# 前端访问地址（system 生产配置使用）
# EUIPD_WEB_ROOT=http://localhost:8080/

# ---------- 平台超级管理员（数据库初始化与 docker/init-super-admin.sh 使用） ----------
# 平台唯一的内置管理账号，只在初始化数据库时按以下参数创建
# 登录手机号（11 位数字）与初始口令（8 至 32 位并同时含字母与数字）
SUPER_ADMIN_PHONE=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=平台管理员

# ---------- 令牌签名密钥位置（可选） ----------
# 缺省为 euipdv2-master/keys/（由 scripts/generate-jwt-keys.sh 生成），从其他目录启动服务时填写绝对路径
# EUIPD_JWT_PRIVATE_KEY=file:/absolute/path/keys/jwt-private.pem
# EUIPD_JWT_PUBLIC_KEY=file:/absolute/path/keys/jwt-public.pem

# ---------- 可选外部集成（不使用时保持为空） ----------
# 阿里云短信：AccessKey、签名与模板编号；为空时短信验证码与短信通知不可用
EUIPD_CUSTOMER_ACCESS_KEY_ID=
EUIPD_CUSTOMER_ACCESS_KEY_SECRET=
EUIPD_SMS_SIGNATURE=
EUIPD_SMS_VERIFICATION_TEMPLATE=
EUIPD_SMS_NOTIFY_TEMPLATE=
# 新机构注册时通知平台管理员复核、复核通过时通知注册人的短信模板
EUIPD_SMS_REGISTER_RECHECK_TEMPLATE=
EUIPD_SMS_REGISTER_PASS_TEMPLATE=

# 阿里云视频点播：登录页介绍视频播放与视频上传；为空时视频不可用
EUIPD_VOD_ACCESS_KEY_ID=
EUIPD_VOD_ACCESS_KEY_SECRET=
# EUIPD_VOD_REGION_ID=cn-shanghai
# EUIPD_VOD_CATEGORY_ID=
# EUIPD_VOD_WORKFLOW_ID=
# EUIPD_VOD_STORAGE_LOCATION=

# 保利威直播：用户编号、应用标识与密钥；为空时跳过直播初始化
EUIPD_POLYV_USER_ID=
EUIPD_POLYV_APP_ID=
EUIPD_POLYV_APP_SECRET=

# GitLab 地址与访问令牌
EUIPD_GITLAB_URL=
EUIPD_GITLAB_TOKEN=

# FTP 服务器（ftp 服务使用）
EUIPD_FTP_USERNAME=
EUIPD_FTP_PASSWORD=
# EUIPD_FTP_HOST=127.0.0.1
# EUIPD_FTP_PORT=21
# EUIPD_FTP_WORKING_DIRECTORY=/

# 泛微 OA（ecology）：地址、应用标识、密钥、公钥与物料表单创建人的 OA 用户编号
EUIPD_OA_HOST=
EUIPD_OA_APPID=
EUIPD_OA_SECRET=
EUIPD_OA_SPK=
EUIPD_OA_MATERIAL_FORM_CREATER=
# 外部 SQL Server 物料库（与 OA 集成配套）
EUIPD_SQL_SERVER_URL=
EUIPD_SQL_SERVER_USER=
EUIPD_SQL_SERVER_PASSWORD=
