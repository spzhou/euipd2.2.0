<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:euipd="http://euipd.com/bpmn"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  targetNamespace="http://euipd.com/flow">
  <bpmn:process id="materialReturn" name="物料退料" isExecutable="true">
    <bpmn:startEvent id="start" name="开始"/>
    <bpmn:userTask id="apply" name="提交退料">
      <bpmn:extensionElements>
        <euipd:node>
          <euipd:assignee resolver="INITIATOR" denyCode="FLOW_ASSIGNEE_NOT_FOUND"/>
          <euipd:onComplete action="WRITE_STATUS" status="APPLICATION"/>
          <euipd:onComplete action="WRITE_PROCESS" text="提交物料退库申请"/>
        </euipd:node>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="approve" name="退料审批">
      <bpmn:extensionElements>
        <euipd:node>
          <euipd:assignee resolver="MATERIAL_SAVED_APPROVER" denyCode="FLOW_ASSIGNEE_NOT_FOUND"/>
          <euipd:guard sourceStates="APPLICATION" denyCode="LIFECYCLE_TRANSITION_FORBIDDEN"/>
          <euipd:onEnter action="SET_NEXT_NODE"/>
          <euipd:onComplete action="WRITE_STATUS" status="#{approveResult}"/>
          <euipd:onComplete action="MATERIAL_RECEIVE" mode="RELEASE" when="#{approveResult=='REJECT'}"/>
          <euipd:onComplete action="WRITE_PROCESS" text="退料审批通过" when="#{approveResult=='APPROVED'}"/>
          <euipd:onComplete action="WRITE_PROCESS" text="退料审批通过" when="#{approveResult=='PRE_APPROVED'}"/>
          <euipd:onComplete action="WRITE_PROCESS" text="退料申请被驳回" when="#{approveResult=='REJECT'}"/>
        </euipd:node>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gwApprove" name="审批结论" default="toRejected"/>
    <bpmn:userTask id="receive" name="收料确认">
      <bpmn:extensionElements>
        <euipd:node>
          <euipd:assignee resolver="ROLE_IN_ORG" roleCode="MATM" denyCode="FLOW_ASSIGNEE_NOT_FOUND"/>
          <euipd:guard sourceStates="APPROVED,PRE_APPROVED" denyCode="LIFECYCLE_TRANSITION_FORBIDDEN"/>
          <euipd:onEnter action="SET_NEXT_NODE"/>
          <euipd:onEnter action="MATERIAL_RECEIVE" mode="PENDING"/>
          <euipd:onComplete action="MATERIAL_RECEIVE" mode="RECEIVED" when="#{receiveResult=='RECEIVED'}"/>
          <euipd:onComplete action="WRITE_BUDGET_EXE" mode="UNPAID" when="#{receiveResult=='RECEIVED'}"/>
          <euipd:onComplete action="WRITE_STATUS" status="REJECT" when="#{receiveResult=='REJECT'}"/>
          <euipd:onComplete action="MATERIAL_RECEIVE" mode="RELEASE" when="#{receiveResult=='REJECT'}"/>
          <euipd:onComplete action="WRITE_PROCESS" text="物料管理员收料确认" when="#{receiveResult=='RECEIVED'}"/>
          <euipd:onComplete action="WRITE_PROCESS" text="物料管理员退回" when="#{receiveResult=='REJECT'}"/>
        </euipd:node>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gwReceive" name="收料结论" default="toReceiveRejected"/>
    <bpmn:userTask id="submit" name="处置并提交">
      <bpmn:extensionElements>
        <euipd:node>
          <euipd:assignee resolver="INITIATOR" denyCode="FLOW_ASSIGNEE_NOT_FOUND"/>
          <euipd:guard sourceStates="APPROVED,PRE_APPROVED,SUPPLEMENT" denyCode="LIFECYCLE_TRANSITION_FORBIDDEN"/>
          <euipd:onEnter action="SET_NEXT_NODE"/>
          <euipd:onComplete action="WRITE_STATUS" status="SUBMIT"/>
          <euipd:onComplete action="WRITE_PROCESS" text="物料处置完成, 提交审批"/>
        </euipd:node>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="recheck" name="退料复核">
      <bpmn:extensionElements>
        <euipd:node>
          <euipd:assignee resolver="MATERIAL_RECHECK" denyCode="FLOW_ASSIGNEE_NOT_FOUND"/>
          <euipd:guard sourceStates="SUBMIT" denyCode="LIFECYCLE_TRANSITION_FORBIDDEN"/>
          <euipd:onEnter action="SET_NEXT_NODE"/>
          <euipd:onComplete action="WRITE_STATUS" status="#{approveResult}"/>
          <euipd:onComplete action="WRITE_BUDGET_EXE" mode="PAID" when="#{approveResult=='COMPLETE'}"/>
          <euipd:onComplete action="WRITE_PROCESS" text="主管经理审批完成"/>
        </euipd:node>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gwRecheck" name="复核结论" default="toSupplement"/>
    <bpmn:userTask id="rejected" name="确认取消">
      <bpmn:extensionElements>
        <euipd:node>
          <euipd:assignee resolver="INITIATOR" denyCode="FLOW_ASSIGNEE_NOT_FOUND"/>
          <euipd:guard sourceStates="REJECT" denyCode="LIFECYCLE_TRANSITION_FORBIDDEN"/>
          <euipd:onEnter action="SET_NEXT_NODE"/>
          <euipd:onComplete action="WRITE_STATUS" status="CANCEL"/>
          <euipd:onComplete action="REVOKE_BUDGET_EXE"/>
          <euipd:onComplete action="WRITE_PROCESS" text="退料申请取消"/>
        </euipd:node>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:endEvent id="endComplete" name="结束"/>
    <bpmn:endEvent id="endCancelled" name="已取消"/>

    <bpmn:sequenceFlow id="toApply" sourceRef="start" targetRef="apply"/>
    <bpmn:sequenceFlow id="toApprove" sourceRef="apply" targetRef="approve"/>
    <bpmn:sequenceFlow id="toGwApprove" sourceRef="approve" targetRef="gwApprove"/>
    <bpmn:sequenceFlow id="toReceive" name="通过" sourceRef="gwApprove" targetRef="receive">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[${approveResult == 'APPROVED' || approveResult == 'PRE_APPROVED'}]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="toRejected" name="驳回" sourceRef="gwApprove" targetRef="rejected"/>
    <bpmn:sequenceFlow id="toGwReceive" sourceRef="receive" targetRef="gwReceive"/>
    <bpmn:sequenceFlow id="toSubmit" name="已收料" sourceRef="gwReceive" targetRef="submit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[${receiveResult == 'RECEIVED'}]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="toReceiveRejected" name="退回" sourceRef="gwReceive" targetRef="rejected"/>
    <bpmn:sequenceFlow id="toRecheck" sourceRef="submit" targetRef="recheck"/>
    <bpmn:sequenceFlow id="toGwRecheck" sourceRef="recheck" targetRef="gwRecheck"/>
    <bpmn:sequenceFlow id="toComplete" name="通过" sourceRef="gwRecheck" targetRef="endComplete">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[${approveResult == 'COMPLETE'}]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="toSupplement" name="退回补充" sourceRef="gwRecheck" targetRef="submit"/>
    <bpmn:sequenceFlow id="toCancelled" sourceRef="rejected" targetRef="endCancelled"/>
  </bpmn:process>
</bpmn:definitions>
